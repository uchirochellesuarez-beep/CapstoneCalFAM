# Frontend example environment file
# Copy to `.env` and fill in real values. Never commit `.env`.

VITE_API_BASE_URL=http://localhost:3000/api
# Optional alias used by some helpers (hostname-based fallback kung walang value)
# VITE_API_URL=http://localhost:3000

# OAuth 2.0 Web client ID — MUST match backend GOOGLE_CLIENT_ID
# In Google Cloud Console → Credentials → Web client → Authorized JavaScript origins,
# add EVERY URL you use to open the app (exact match, no path):
#   http://localhost:5173
#   http://127.0.0.1:5173
#   http://YOUR-LAN-IP:5173   (only if you open via Wi‑Fi IP)
# Then wait a few minutes and hard-refresh the browser.
VITE_GOOGLE_CLIENT_ID=
